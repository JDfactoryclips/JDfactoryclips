let circle, rectangle;

function setup() {
  createCanvas(800, 600);
  resetShapes(); // Initialize the shapes
}

function draw() {
  background(30);

  // Update and draw the circle
  updateShape(circle);
  drawShape(circle);

  // Update and draw the rectangle
  updateShape(rectangle);
  drawShape(rectangle);

  // Check for collision and handle it
  if (shapesOverlap(circle, rectangle)) {
    handleCollision(circle, rectangle);
  }
}

// Function to create a circle object
function createCircle(x, y, radius, vx, vy, color) {
  return {
    type: 'circle',
    x,
    y,
    radius,
    vx,
    vy,
    color,
  };
}

// Function to create a rectangle object
function createRectangle(x, y, width, height, vx, vy, color) {
  return {
    type: 'rectangle',
    x,
    y,
    width,
    height,
    vx,
    vy,
    color,
  };
}

// Reset shapes to their initial state
function resetShapes() {
  circle = createCircle(
    random(50, width - 50),
    random(50, height - 50),
    50,
    random(-3, 3),
    random(-3, 3),
    color(random(255), random(255), random(255))
  );

  rectangle = createRectangle(
    random(50, width - 150),
    random(50, height - 150),
    100,
    50,
    random(-2, 2),
    random(-2, 2),
    color(random(255), random(255), random(255))
  );
}

// Update shape's position and handle edge bouncing
function updateShape(shape) {
  shape.x += shape.vx;
  shape.y += shape.vy;

  // Bounce off edges
  if (shape.type === 'circle') {
    if (shape.x - shape.radius < 0 || shape.x + shape.radius > width) {
      shape.vx *= -1;
    }
    if (shape.y - shape.radius < 0 || shape.y + shape.radius > height) {
      shape.vy *= -1;
    }
  } else if (shape.type === 'rectangle') {
    if (shape.x < 0 || shape.x + shape.width > width) {
      shape.vx *= -1;
    }
    if (shape.y < 0 || shape.y + shape.height > height) {
      shape.vy *= -1;
    }
  }
}

// Draw shape based on its type
function drawShape(shape) {
  fill(shape.color);
  noStroke();
  if (shape.type === 'circle') {
    ellipse(shape.x, shape.y, shape.radius * 2);
  } else if (shape.type === 'rectangle') {
    rect(shape.x, shape.y, shape.width, shape.height);
  }
}

// Check if the two shapes overlap
function shapesOverlap(circle, rectangle) {
  if (circle.type === 'circle' && rectangle.type === 'rectangle') {
    let closestX = constrain(circle.x, rectangle.x, rectangle.x + rectangle.width);
    let closestY = constrain(circle.y, rectangle.y, rectangle.y + rectangle.height);
    let distance = dist(circle.x, circle.y, closestX, closestY);
    return distance < circle.radius;
  }
  return false;
}

// Handle collision by changing color and reversing direction
function handleCollision(shape1, shape2) {
  shape1.color = color(random(255), random(255), random(255));
  shape2.color = color(random(255), random(255), random(255));
  shape1.vx *= -1;
  shape1.vy *= -1;
  shape2.vx *= -1;
  shape2.vy *= -1;
}

// Reset the program when the 'r' key is pressed
function keyPressed() {
  if (key === 'r' || key === 'R') {
    resetShapes();
  }
}

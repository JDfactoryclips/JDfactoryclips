let ball;

function setup() {
  createCanvas(800, 600);
  ball = new PhysicsCircle(width / 2, 100, 30, 1.5);
}

function draw() {
  background(255);

  ball.applyGravity();
  ball.applyFriction();
  ball.update();
  ball.edges();
  ball.display();
}

function keyPressed() {
  if (key === ' ') {
    let wind = createVector(1.5, 0);
    ball.applyForce(wind);
  }
}

class PhysicsCircle {
  constructor(x, y, r, mass = 1) {
    this.pos = createVector(x, y);
    this.vel = createVector(0, 0);
    this.acc = createVector(0, 0);
    this.r = r;
    this.mass = mass;
    this.damping = 0.8;
  }

  applyForce(force) {
    let f = p5.Vector.div(force, this.mass);
    this.acc.add(f);
  }

  applyGravity() {
    let gravity = createVector(0, 0.4 * this.mass);
    this.applyForce(gravity);
  }

  applyFriction(c = 0.05) {
    let friction = this.vel.copy();
    if (friction.mag() > 0) {
      friction.normalize();
      friction.mult(-1);
      friction.mult(c);
      this.applyForce(friction);
    }
  }

  update() {
    this.vel.add(this.acc);
    this.pos.add(this.vel);
    this.acc.mult(0);
  }

  edges() {
    if (this.pos.y + this.r > height) {
      this.pos.y = height - this.r;
      this.vel.y *= -this.damping;
    }

    if (this.pos.x + this.r > width) {
      this.pos.x = width - this.r;
      this.vel.x *= -this.damping;
    }

    if (this.pos.y - this.r < 0) {
      this.pos.y = this.r;
      this.vel.y *= -this.damping;
    }

    if (this.pos.x - this.r < 0) {
      this.pos.x = this.r;
      this.vel.x *= -this.damping;
    }
  }

  display() {
    fill(100, 150, 255);
    stroke(0);
    strokeWeight(2);
    ellipse(this.pos.x, this.pos.y, this.r * 2);
  }
}



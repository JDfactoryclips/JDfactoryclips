let mover;

function setup() {
  createCanvas(800, 600);
  mover = new Mover(50, createVector(width / 2, height / 2), 1);
}

function draw() {
  background(255);

  // Apply gravity
  let gravity = createVector(0, 0.2 * mover.mass);
  mover.applyForce(gravity);

  // Apply friction if on ground
  if (mover.position.y >= height - mover.radius) {
    let friction = mover.velocity.copy();
    friction.normalize();
    friction.mult(-1);
    friction.mult(0.05);
    mover.applyForce(friction);
  }

  mover.update();
  mover.edges();
  mover.display();
}

// Interactivity
function keyPressed() {
  if (key === ' ') {
    let wind = createVector(0.5, 0);
    mover.applyForce(wind);
  }
}

function mousePressed() {
  // Click gives upward boost
  let boost = createVector(0, -5);
  mover.applyForce(boost);
}

// Mover class
class Mover {
  constructor(radius, position, mass) {
    this.radius = radius;
    this.position = position.copy();
    this.velocity = createVector(0, 0);
    this.acceleration = createVector(0, 0);
    this.mass = mass;
  }

  applyForce(force) {
    let f = p5.Vector.div(force, this.mass);
    this.acceleration.add(f);
  }

  update() {
    this.velocity.add(this.acceleration);
    this.position.add(this.velocity);
    this.acceleration.mult(0); // reset acceleration
  }

  display() {
    fill(100, 150, 255);
    stroke(0);
    strokeWeight(1);
    ellipse(this.position.x, this.position.y, this.radius * 2);
  }

  edges() {
    if (this.position.y + this.radius > height) {
      this.position.y = height - this.radius;
      this.velocity.y *= -0.8; // bounce with damping
    }

    if (this.position.x + this.radius > width) {
      this.position.x = width - this.radius;
      this.velocity.x *= -1;
    } else if (this.position.x - this.radius < 0) {
      this.position.x = this.radius;
      this.velocity.x *= -1;
    }
  }
}


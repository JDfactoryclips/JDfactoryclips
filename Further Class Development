let graph;

function setup() {
  createCanvas(900, 600);
  textFont('Arial');

  // Instantiate a new empty graph
  graph = new BarGraph(60, 60, width - 120, height - 120, "Top NBA Scorers (2023–24 PPG)");

  // Add data using addData(label, value, color)
  graph.addData("Luka Dončić", 33.9, '#FF6B6B');
  graph.addData("Shai G-Alexander", 31.4, '#FFD93D');
  graph.addData("Giannis", 30.7, '#6BCB77');
  graph.addData("Tatum", 27.0, '#4D96FF');
  graph.addData("Durant", 27.1, '#FF6BF0');
  graph.addData("Curry", 26.4, '#FFA36C');
  graph.addData("Embiid", 34.7, '#8D6EFF');
  graph.addData("LeBron", 25.0, '#00B5B8');
}

function draw() {
  background(255);
  graph.draw();
}

class BarGraph {
  constructor(x, y, w, h, title) {
    this.x = x;
    this.y = y;
    this.w = w;
    this.h = h;
    this.title = title;

    this.labels = [];
    this.data = [];
    this.colors = [];
    this.maxValue = 0;
  }

  addData(label, value, color) {
    this.labels.push(label);
    this.data.push(value);
    this.colors.push(color);

    if (value > this.maxValue) {
      this.maxValue = value;
    }
  }

  draw() {
    this.drawTitle();
    this.drawAxes();
    this.drawBars();
  }

  drawTitle() {
    fill(0);
    noStroke();
    textAlign(CENTER, TOP);
    textSize(24);
    text(this.title, width / 2, this.y - 40);
  }

  drawAxes() {
    stroke(0);
    strokeWeight(2);
    line(this.x, this.y + this.h, this.x + this.w, this.y + this.h); // X-axis
    line(this.x, this.y + this.h, this.x, this.y); // Y-axis

    let steps = 5;
    for (let i = 0; i <= steps; i++) {
      let val = i * (this.maxValue / steps);
      let yPos = map(val, 0, this.maxValue, this.y + this.h, this.y);

      stroke(200);
      line(this.x, yPos, this.x + this.w, yPos);

      noStroke();
      fill(0);
      textAlign(RIGHT, CENTER);
      text(nf(val, 0, 1), this.x - 10, yPos);
    }
  }

  drawBars() {
    if (this.data.length === 0) return;

    let barWidth = this.w / this.data.length;

    for (let i = 0; i < this.data.length; i++) {
      let barHeight = map(this.data[i], 0, this.maxValue, 0, this.h);
      let x = this.x + i * barWidth;
      let y = this.y + this.h - barHeight;

      fill(this.colors[i]);
      stroke(0);
      rect(x, y, barWidth - 10, barHeight);

      fill(0);
      noStroke();
      textAlign(CENTER, BOTTOM);
      text(nf(this.data[i], 0, 1), x + (barWidth - 10) / 2, y - 5); // Value

      textAlign(CENTER, TOP);
      textSize(11);
      text(this.labels[i], x + (barWidth - 10) / 2, this.y + this.h + 5); // Label
    }
  }
}
